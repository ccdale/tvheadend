# Maintainer: Chris Allison <chris.charles.allison+tvheadend@gmail.com>
_pkgname=tvheadend-git
pkgname=python-tvheadend
pkgver=0.1.0
pkgrel=1
pkgdesc="Remote access helpers for TVHeadend"
arch=('any')
url="https://github.com/ccdale/${_pkgname%-git}"
license=('custom:unknown')
depends=('python' 'python-requests')
makedepends=('git' 'uv' 'python-installer')
provides=("${_pkgname%-git}")
conflicts=("${_pkgname%-git}")
source=("git+file:///${HOME}/src/${_pkgname%-git}#branch=main")
md5sums=('SKIP')

pkgver() {
    cd "$srcdir/${_pkgname%-git}"
    read xname xversion < <(uv version)
    printf "%s" "${xversion}"
}

build() {
    cd "$srcdir/${_pkgname%-git}"
    uv build
}

package() {
    cd "$srcdir/${_pkgname%-git}"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
